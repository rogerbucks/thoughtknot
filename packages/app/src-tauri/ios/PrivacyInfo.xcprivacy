<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple's privacy manifest for the iPhone and iPad app. It goes at the top of the built app
     (scripts/ios-build.mjs puts it in the Xcode project). The app tracks nobody and collects nothing: notes stay on
     the device. The reasons below are for the system calls the built app links (checked with `nm -u` on the binary,
     15 Nov 2026): file times (stat, utimes), free disk space (statfs) and the user's own settings (UserDefaults). -->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- C617.1: times of files inside the app's own Documents folder, where the notes live. -->
        <string>C617.1</string>
        <!-- 3B52.1: times of notes the person opens in place from the Files app. -->
        <string>3B52.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- E174.1: check there is room before writing a note. -->
        <string>E174.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- CA92.1: the app's own settings, read and written by the app alone. -->
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
