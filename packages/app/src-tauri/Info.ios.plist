<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the iPhone and iPad app's own Info.plist by Tauri. The app's Documents folder, where its notes live,
     is shown in the Files app under On My iPhone, and a note there is opened where it is, never copied in. -->
<plist version="1.0">
<dict>
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- The app has no encryption of its own: the vault key sits in Apple's Keychain, and sync uses the Web Crypto that
       Apple's WebKit provides. That is Apple's built-in encryption, so the export answer is "exempt" (Roger, 14 Nov
       2026, for TestFlight builds he alone tests). A lawyer confirms it before any public release (LEGAL-3). -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
