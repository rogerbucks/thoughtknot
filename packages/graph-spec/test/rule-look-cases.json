{
  "about": "Shared cases for a rule's look run as a lens (editor spec §56, rule_look_when). Each case calls queryThings, queryLinks or runLens of packages/graph-spec/src/lenses/saved-lenses.js on its graph, with its args, and the Python twin (graphspec.engine.lenses.saved_lenses) must give the same answer. Made once by the JavaScript library.",
  "cases": [
    {
      "name": "a when on a kind finds the things the same lens finds",
      "graph": {
        "nodes": [
          [
            "late_work",
            ["Lens"],
            {
              "name": "Late work",
              "query": "Task WHERE status == 'late'"
            }
          ],
          [
            "t1",
            ["Task"],
            {
              "status": "late",
              "cost": 120,
              "likelihood": "unlikely"
            }
          ],
          [
            "t2",
            ["Task"],
            {
              "status": "done",
              "cost": 40
            }
          ],
          [
            "t3",
            ["Task"],
            {
              "status": "late"
            }
          ],
          [
            "p1",
            ["Person"],
            {
              "name": "Ann"
            }
          ],
          [
            "p2",
            ["Person"],
            {
              "name": "Bo",
              "status": "late"
            }
          ]
        ],
        "edges": [
          [
            "t1",
            "NEEDS",
            "t2",
            {
              "weight": 3
            }
          ],
          [
            "t2",
            "NEEDS",
            "t3",
            {
              "weight": 1
            }
          ],
          ["p1", "OWNS", "t1", {}],
          [
            "p1",
            "OWNS",
            "t3",
            {
              "weight": 5
            }
          ]
        ]
      },
      "call": "queryThings",
      "args": ["Task WHERE status == 'late'"],
      "expected": ["t1", "t3"]
    },
